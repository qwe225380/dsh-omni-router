{
  "name": "dsh-omni-router",
  "version": "0.18.0",
  "description": "Omni Router - auto-routing DeepSeek Harness preset: simple tasks run directly, complex tasks plan first with approval gate, coding tasks get TDD/delivery-gate guidance.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./installer": "./lib/installer.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "router",
    "plan-mode",
    "tdd"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "agent.cordis.yml",
    "preset.yml",
    "src",
    "test",
    "benchmark",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "install.ps1",
    "install.sh",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/omni-router.test.mjs",
    "benchmark": "node benchmark/run.mjs",
    "install:preset": "node scripts/install-preset.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
