@echo off
rem omni arm wrapper: separate independent DSH_HOME, headless profile, WITH Omni.
rem The omni.patch.yml overlay (generated by bootstrap.mjs) mounts the
rem omni-router Core row into the headless host plane.
rem Usage:
rem   run-omni.cmd "<task>"                        (SMOKE_ROOT = %~dp0)
rem   run-omni.cmd --smoke-root="<root>" "<task>"  (bootstrap fallback when the
rem                                                 wrapper was copied to a
rem                                                 no-space temp dir)
set "SMOKE_ROOT_ARG=%~1"
set "TASK=%~1"
set "SMOKE_ROOT_REAL=%~dp0"
if "%SMOKE_ROOT_ARG:~0,13%"=="--smoke-root=" (
  set "SMOKE_ROOT_REAL=%SMOKE_ROOT_ARG:~13%"
  set "TASK=%~2"
)
set "DSH_HOME=%SMOKE_ROOT_REAL%homes\omni"
if not exist "%DSH_HOME%" mkdir "%DSH_HOME%"

where dsh >nul 2>nul
if %errorlevel%==0 (
  dsh --profile headless --patch "%SMOKE_ROOT_REAL%omni.patch.yml" "%TASK%"
) else (
  npx --yes @deepseek-ai/dsh --profile headless --patch "%SMOKE_ROOT_REAL%omni.patch.yml" "%TASK%"
)