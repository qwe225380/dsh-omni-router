@echo off
rem omni arm wrapper: separate independent DSH_HOME, headless profile, WITH Omni.
rem The omni.patch.yml overlay (generated by bootstrap.mjs) mounts the
rem omni-router row into the headless host plane.
set "SMOKE_ROOT=%~dp0"
set "DSH_HOME=%SMOKE_ROOT%homes\omni"
if not exist "%DSH_HOME%" mkdir "%DSH_HOME%"

where dsh >nul 2>nul
if %errorlevel%==0 (
  dsh --profile headless --patch "%SMOKE_ROOT%omni.patch.yml" "%~1"
) else (
  npx --yes @deepseek-ai/dsh --profile headless --patch "%SMOKE_ROOT%omni.patch.yml" "%~1"
)